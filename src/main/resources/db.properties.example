# PackFlow Database Configuration Example
# Copy this file to db.properties and set your MySQL database credentials

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/packflow_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
db.password=your_mysql_password

# Connection Pool / Timeout Settings
db.initialPoolSize=5
db.maxPoolSize=20
db.connectionTimeoutMs=30000
